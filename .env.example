# Bot token from the Discord Developer Portal
MITAURI_DISCORD_TOKEN=

# Your numeric Discord user ID. Only this user can talk to Mitauri.
MITAURI_DISCORD_USER_ID=

# Your time zone
MITAURI_TIMEZONE=Europe/Berlin

# This device's Tailscale address (`tailscale ip -4`), so the phone app can connect
MITAURI_API_HOST=

# Optional
# USB ports of the Bluetooth presence sensors, each named for where it sits
# MITAURI_PRESENCE_SENSORS=home=/dev/ttyUSB0
# Sensors on plain power that broadcast for the phone to hear, after `mitauri presence-key NAME`
# MITAURI_PRESENCE_BEACONS=desk
# Free key from console.groq.com. Makes Groq do the speech recognition, so your recordings go to Groq.
# Without it, everything stays on this machine.
# MITAURI_GROQ_API_KEY=
# Speech recognition, to overrule that: groq, parakeet or whisper. parakeet is much faster (Whisper still hears clips under 2 s), whisper is used for everything otherwise
# MITAURI_SPEECH_ENGINE=parakeet
# Whisper's model: base is faster, small is more accurate
# MITAURI_WHISPER_MODEL=small
# Lower this on a machine that also has other work to do
# MITAURI_WHISPER_THREADS=8
# Morning briefing time, off unless set
# MITAURI_BRIEFING_TIME=08:00
# Everyday model, and the one it can call for hard problems
# MITAURI_MODEL=haiku
# MITAURI_THINKING_MODEL=sonnet
# How much the everyday model thinks before answering. low starts speaking soonest
# MITAURI_EFFORT=low
# Writes self-building proposals
# MITAURI_PROPOSAL_MODEL=opus
# Language you speak: "de", "en", or "auto" to detect it, which is a little slower
# MITAURI_SPEECH_LANGUAGE=de
# MITAURI_CLAUDE_BIN=claude
# MITAURI_DATA_DIR=~/.local/share/mitauri
